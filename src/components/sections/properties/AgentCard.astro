---
import { Image } from "astro:assets";

interface Props {
  name: string;
  role: string;
  email: string;
  phone: string;
  image: ImageMetadata;
}

const { name, role, email, phone, image } = Astro.props;

// Format phone number for WhatsApp (remove any non-digit characters)
const whatsappPhone = phone.replace(/\D/g, '');
---

<div class="agent-card">
  <div class="agent-image-container">
    <Image
      src={image}
      alt={name}
      class="agent-image"
      width={300}
      height={300}
    />
  </div>
  <div class="agent-info">
    <h2 class="agent-name">{name}</h2>
    <p class="agent-role">{role}</p>
    
    <div class="agent-contact">
      <a href={`tel:${phone}`} class="contact-button phone-button">
        <span class="icon">📞</span>
        <span>Llamar</span>
      </a>
      
      <a href={`https://wa.me/${whatsappPhone}`} target="_blank" rel="noopener noreferrer" class="contact-button whatsapp-button">
        <span class="icon">💬</span>
        <span>WhatsApp</span>
      </a>
    </div>

    <div class="agent-details">
      <div class="detail-item">
        <span class="detail-icon">✉️</span>
        <span class="detail-text">{email}</span>
      </div>
      <div class="detail-item">
        <span class="detail-icon">📍</span>
        <span class="detail-text">Veracruz, México</span>
      </div>
    </div>
  </div>
</div>

<style>
  .agent-card {
    display: flex;
    flex-direction: column;
    background-color: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    width: 100%;
    max-width: 500px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .agent-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
  }

  .agent-image-container {
    width: 100%;
    height: 300px;
    overflow: hidden;
  }

  .agent-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .agent-card:hover .agent-image {
    transform: scale(1.03);
  }

  .agent-info {
    padding: 2rem;
  }

  .agent-name {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    color: #1a202c;
  }

  .agent-role {
    font-size: 1rem;
    color: #64748b;
    margin: 0.25rem 0 1.5rem;
    font-weight: 500;
  }

  .agent-contact {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .contact-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    text-decoration: none;
    flex: 1;
  }

  .phone-button {
    background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #e2e8f0;
  }

  .phone-button:hover {
    background-color: #f1f5f9;
  }

  .whatsapp-button {
    background-color: #25d366;
    color: white;
  }

  .whatsapp-button:hover {
    background-color: #22c55e;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .agent-details {
    margin-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 1.5rem;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .detail-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
  }

  .detail-text {
    font-size: 0.9375rem;
    color: #334155;
  }

  @media (min-width: 640px) {
    .agent-card {
      flex-direction: row;
      max-width: 800px;
    }

    .agent-image-container {
      width: 40%;
      height: auto;
    }

    .agent-info {
      width: 60%;
    }
  }

  @media (max-width: 639px) {
    .agent-contact {
      flex-direction: column;
    }
  }
</style>